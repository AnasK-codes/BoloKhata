{
  "name": "bol-bill",
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "private": true,
  "description": "Realtime Hinglish voice-to-bill PWA for kirana stores",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,gateway -c cyan,magenta \"pnpm --filter @bolbill/web dev\" \"pnpm --filter @bolbill/gateway dev\"",
    "dev:mock": "concurrently --kill-others-on-fail -n mock,web,gateway -c yellow,cyan,magenta \"pnpm --filter @bolbill/mock-gnani start\" \"pnpm --filter @bolbill/web dev\" \"pnpm --filter @bolbill/gateway dev:mock\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "spike": "pnpm --filter @bolbill/scripts spike",
    "warm-phrases": "pnpm --filter @bolbill/scripts warm-phrases",
    "loadtest": "pnpm --filter @bolbill/scripts loadtest",
    "measure-rtt": "pnpm --filter @bolbill/scripts measure-rtt",
    "check:bundle": "pnpm --filter @bolbill/scripts check:bundle",
    "smoke": "pnpm --filter @bolbill/scripts smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
