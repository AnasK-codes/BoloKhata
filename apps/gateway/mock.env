# Used by `pnpm dev:mock`: the gateway talks to tools/mock-gnani instead of the real Gnani API.
# Nothing here is a real secret.
GNANI_API_KEY=mock-key-not-real
GNANI_STT_URL=ws://127.0.0.1:9101/stt/v3/stream
GNANI_TTS_URL=ws://127.0.0.1:9102/api/v1/tts
LLM_PROVIDER=none
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TOKEN_SECRET=mock-secret-not-for-production
PORT=8080
LOG_LEVEL=info
