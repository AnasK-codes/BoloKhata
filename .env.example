# Copy to .env and fill in. NEVER commit .env. Only NEXT_PUBLIC_GATEWAY_URL may reach the browser.

# --- production only (docker-compose.prod.yml; see docs/DEPLOY.md) ---
# The public host name, without https://, and an email for Let's Encrypt notices.
DOMAIN=
ACME_EMAIL=

# --- web (public, not a secret) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
# Public origin for CSRF checks. Must match the URL the browser uses to reach the app.
# In production: https://your.domain — in dev with ngrok: https://xxxx.ngrok-free.dev
APP_ORIGIN=http://localhost:3000

# --- cloud account auth (also copy URL/key to apps/web/.env.local) ---
# Optional: admin/migration connection only. Runtime login still needs the project API key.
DATABASE_URL=
# Use the project anon/publishable key, NEVER a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Set true for deployment: missing auth configuration then fails startup.
ACCOUNT_AUTH_REQUIRED=true
# TEMPORARY, for a demo only: true turns account login off everywhere (set it here and for the
# web app). Leave it false or remove it for real use.
DEMO_NO_AUTH=false

# --- gateway: Gnani ---
GNANI_API_KEY=replace-me
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
# Defaults below are README starting points; docs/LATENCY.md (after `pnpm spike`) is the source of truth.
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_FORMAT=verbatim
GNANI_STT_VAD_THRESHOLD=0.7
GNANI_STT_MIN_SILENCE_MS=500
GNANI_STT_MIN_SPEECH_MS=100
GNANI_STT_MIN_SEGMENT_MS=120
# persistent = one socket per session, rotated before the 15 min cap; spare = fresh socket after every turn
GNANI_STT_STRATEGY=persistent
GNANI_STT_IDLE_TIMEOUT_SEC=900
GNANI_STT_ROTATE_AFTER_MIN=13
# paced = keep 32 ms cadence when draining on release; burst = send the backlog at once
STT_DRAIN=paced
MAX_UTTERANCE_SECONDS=30
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Devansh
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SAMPLE_RATE=24000
GNANI_TTS_CACHE_DIR=.tts-cache
TTS_CACHE_MEMORY_MB=16

# --- gateway: LLM (optional; rules-only works without it) ---
LLM_PROVIDER=none
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
# Only for LLM_PROVIDER=openai-compatible (any server with POST {base}/chat/completions).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional (Gemini): none | minimal | low | medium | high. Lower thinks less and answers faster.
OPENAI_REASONING_EFFORT=
LLM_MODE=fallback
# rules_ai = the rule parser first, the model only when the rules are unsure (default).
# ai_only  = the model reads every sentence and calls tools; needs LLM_PROVIDER other than none. Every turn waits
#            for the model (one measured call took 4.2 s), so raise LLM_TIMEOUT_MS to 5000 or more. A bare haan/nahi stays instant.
PARSER_MODE=rules_ai
LLM_TIMEOUT_MS=1200

# --- gateway: guard ---
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TOKEN_SECRET=replace-with-a-long-random-string
DEMO_ACCESS_CODE=
MAX_SESSIONS=3
MAX_SESSION_MINUTES=10
DAILY_STT_SECONDS_CAP=1800
DAILY_TTS_CHARS_CAP=20000
SESSION_RATE_PER_IP_PER_MIN=10
SESSION_RATE_GLOBAL_PER_MIN=60
# GET /metrics is disabled unless this is set
METRICS_TOKEN=
# Today's credit usage survives restarts in this file (compose uses the cache volume). Blank = memory only.
CREDIT_USAGE_FILE=.tts-cache/credit-usage.json

# --- gateway: server ---
PORT=8080
LOG_LEVEL=info
# true behind Caddy/a proxy so rate limits see the real client IP
TRUST_PROXY=false
DRAIN_TIMEOUT_MS=10000
