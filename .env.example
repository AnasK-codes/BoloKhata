# Copy to .env and fill in. NEVER commit .env. Only NEXT_PUBLIC_GATEWAY_URL may reach the browser.

# --- web (public, not a secret) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# --- gateway: Gnani ---
GNANI_API_KEY=replace-me
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
# Defaults below are README starting points; docs/LATENCY.md (after `pnpm spike`) is the source of truth.
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto
GNANI_STT_FORMAT=verbatim
GNANI_STT_VAD_THRESHOLD=0.7
GNANI_STT_MIN_SILENCE_MS=500
GNANI_STT_MIN_SPEECH_MS=100
GNANI_STT_MIN_SEGMENT_MS=120
# persistent = one socket per session, rotated before the 15 min cap; spare = fresh socket after every turn
GNANI_STT_STRATEGY=persistent
GNANI_STT_IDLE_TIMEOUT_SEC=900
GNANI_STT_ROTATE_AFTER_MIN=13
# paced = keep 32 ms cadence when draining on release; burst = send the backlog at once
STT_DRAIN=paced
MAX_UTTERANCE_SECONDS=30
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SAMPLE_RATE=24000
GNANI_TTS_CACHE_DIR=.tts-cache
TTS_CACHE_MEMORY_MB=16

# --- gateway: LLM (optional; rules-only works without it) ---
LLM_PROVIDER=none
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=
LLM_TIMEOUT_MS=1200

# --- gateway: guard ---
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TOKEN_SECRET=replace-with-a-long-random-string
DEMO_ACCESS_CODE=
MAX_SESSIONS=3
MAX_SESSION_MINUTES=10
DAILY_STT_SECONDS_CAP=1800
DAILY_TTS_CHARS_CAP=20000
SESSION_RATE_PER_IP_PER_MIN=10
SESSION_RATE_GLOBAL_PER_MIN=60
# GET /metrics is disabled unless this is set
METRICS_TOKEN=

# --- gateway: server ---
PORT=8080
LOG_LEVEL=info
# true behind Caddy/a proxy so rate limits see the real client IP
TRUST_PROXY=false
DRAIN_TIMEOUT_MS=10000
