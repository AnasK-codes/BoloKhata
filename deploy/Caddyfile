# One origin for everything: https://{$DOMAIN}
#   /ws  /session  /healthz  -> the gateway (WebSocket and token endpoint)
#   everything else          -> the web app
# Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 and 443 must be open).
# /metrics is deliberately not routed: it is reachable only from inside the instance.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	@gateway path /ws /ws/* /session /session/* /healthz
	handle @gateway {
		# flush_interval -1: send bytes as they arrive (audio must not be buffered). No `encode`
		# here: compressing audio frames only adds latency. WebSocket upgrades are proxied
		# automatically.
		# stream_close_delay: a config reload keeps open sockets (a held mic) instead of cutting them.
		# Caddy sets no idle timeout on an upgraded WebSocket; the gateway's 15 s ping keeps it alive.
		reverse_proxy gateway:8080 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	handle {
		# Account and profile requests are small JSON; nothing legitimate is larger.
		request_body {
			max_size 1MB
		}
		encode zstd gzip
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self)"
	}
	# The service worker and manifest must be fetched fresh so updates are noticed (">" replaces the
	# header Next sends instead of adding a second one). Next already sends
	# a long immutable Cache-Control for its hashed /_next/static files.
	@fresh path /sw.js /manifest.webmanifest
	header @fresh >Cache-Control "no-cache"

	log {
		output stdout
		# The WebSocket URL carries a one-time session token: keep it out of the logs.
		format filter {
			request>uri query {
				replace token REDACTED
			}
			wrap console
		}
	}
}
